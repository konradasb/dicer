# The dicer package's %preun: $1 is 0 when the package is removed, 1 when
# an upgrade replaces it. Only removing it stops the daemon; guests keep
# running, unmanaged.

if [ "$1" -eq 0 ] && [ -d /run/systemd/system ]; then
  systemctl disable --now dicerd.service || true
fi

exit 0
